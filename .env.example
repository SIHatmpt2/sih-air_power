# AERO-OPS Environment Configuration (SIH26250)
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL with PostGIS enabled)
# Example: postgis://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgis://postgres:postgres@localhost:5432/aero_ops_db

# Redis Channel Layer (Django Channels WebSockets)
REDIS_URL=redis://localhost:6379/0

# Simulation Configuration
SIMULATION_MODE=True
DEFAULT_SCENARIO=baseline
DEFAULT_SEED=26250
